# Ejecuta la revisión dos veces al día (08:00 y 16:30, zona horaria del servidor)
# Ejemplo para Ubuntu en /home/nacho/proyectos/GestorMarket

0 8 * * * cd /home/nacho/proyectos/GestorMarket && /home/nacho/proyectos/GestorMarket/.venv/bin/python3 src/cardmarket_monitor.py --env-file .env --ignored-file ignored_cards.txt >> /home/nacho/proyectos/GestorMarket/logs/cardmarket-monitor.log 2>&1
30 16 * * * cd /home/nacho/proyectos/GestorMarket && /home/nacho/proyectos/GestorMarket/.venv/bin/python3 src/cardmarket_monitor.py --env-file .env --ignored-file ignored_cards.txt >> /home/nacho/proyectos/GestorMarket/logs/cardmarket-monitor.log 2>&1
